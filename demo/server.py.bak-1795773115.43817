import datetime
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# Chaos state: when True, /health returns 500 (the "inventory service" is broken).
chaos = False

# Each hour, fail during these minutes (UTC). Empty = only manual toggles.
chaos_window = os.environ.get("CHAOS_MINUTES", "15-20")


def scheduled_chaos(now):
    if not chaos_window:
        return False
    try:
        start, end = (int(x) for x in chaos_window.split("-", 1))
        return start <= now.minute < end
    except ValueError:
        return False


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        global chaos
        now = datetime.datetime.now(datetime.timezone.utc)
        broken = chaos or scheduled_chaos(now)
        if self.path == "/health":
            if broken:
                self._send(500, "inventory database connection failed\n")
            else:
                self._send(200, "ok\n")
        elif self.path == "/healthz":  # always 200: Render health check + keep-warm pinger
            self._send(200, "ok\n")
        elif self.path == "/chaos/on":
            chaos = True
            self._send(200, "chaos ON: /health will return 500\n")
        elif self.path == "/chaos/off":
            chaos = False
            self._send(200, "chaos OFF\n")
        elif self.path == "/":
            state = "FAILING (500)" if broken else "healthy (200)"
            self._send(200, f"inventory service demo — {state}\n"
                            f"chaos until :{now.minute:02d} — window {chaos_window or 'manual only'}\n")
        else:
            self._send(404, "not found\n")

    def log_message(self, *args):  # keep stdout clean; worker log is the feed
        pass


if __name__ == "__main__":
    port = int(os.environ.get("PORT", "9999"))
    print(f"inventory demo service on :{port}, chaos window={chaos_window!r}", flush=True)
    ThreadingHTTPServer(("0.0.0.0", port), Handler).serve_forever()
