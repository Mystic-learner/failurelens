# Copy to .env and edit. Every setting is optional; the values shown are the defaults.
# docker compose overrides DATABASE_URL for the app container.

# --- Database (dev compose database listens on host port 55432)
DATABASE_URL=postgresql+asyncpg://failurelens:failurelens@localhost:55432/failurelens

# --- General
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
HEALTH_DB_TIMEOUT_S=2.0

# --- Ingest: bounded queue (full queue answers 429 with Retry-After)
MAX_BODY_BYTES=10485760
QUEUE_MAX_SIZE=1000
QUEUE_MAX_BYTES=67108864
QUEUE_RETRY_AFTER_S=1

# --- Workers
WORKER_COUNT=4
WORKER_FLUSH_INTERVAL_S=5.0
STREAM_IDLE_S=10.0

# --- Embeddings: openai | local | fake  ("local" arrives in Phase 8)
EMBEDDING_PROVIDER=openai
EMBEDDING_WORKER_ENABLED=true

# --- LLM diagnosis (needs OPENAI_API_KEY; without it diagnosis is disabled)
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_S=30.0
LLM_HOURLY_TOKEN_CAP=200000
DIAGNOSIS_RUNNER_ENABLED=true

# --- Live events (WebSocket)
WS_MAX_CLIENTS=200
WS_CLIENT_QUEUE=100
WS_SEND_TIMEOUT_S=5.0
EVENT_POLL_S=0.5
EVENT_LAG_S=5.0