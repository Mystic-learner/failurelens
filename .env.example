# Copy to .env and edit. docker compose overrides DATABASE_URL for the app container.
DATABASE_URL=postgresql+asyncpg://failurelens:failurelens@localhost:5432/failurelens
LOG_LEVEL=INFO
MAX_BODY_BYTES=10485760
QUEUE_MAX_SIZE=1000
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:5173
